{
  "name": "indextts-studio",
  "productName": "IndexTTS Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local IndexTTS-2.5 studio with MLX and PyTorch MPS engines",
  "main": "apps/desktop/dist/main.js",
  "scripts": {
    "predev": "node scripts/patch-electron-name.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --config apps/renderer/vite.config.ts",
    "backend:install": "bash scripts/setup-backend.sh",
    "runtime:setup": "bash scripts/setup-runtime.sh",
    "translate:setup": "bash scripts/setup-translate.sh",
    "build:renderer": "vite build --config apps/renderer/vite.config.ts",
    "build:desktop": "tsc -p apps/desktop/tsconfig.json",
    "build": "npm run build:renderer && npm run build:desktop",
    "prestart": "node scripts/patch-electron-name.mjs",
    "start": "electron .",
    "typecheck": "tsc -p apps/desktop/tsconfig.json --noEmit && tsc -p apps/renderer/tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.indextts.studio",
    "productName": "IndexTTS Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/dist/**",
      "dist/renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "requirements.txt"
        ]
      },
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "scripts/setup-runtime.sh",
        "to": "scripts/setup-runtime.sh"
      },
      {
        "from": "scripts/setup-translate.sh",
        "to": "scripts/setup-translate.sh"
      },
      {
        "from": "vendor/index-tts",
        "to": "vendor/index-tts"
      },
      {
        "from": "bin/uv",
        "to": "bin/uv"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "需要访问麦克风来录制声音参考。",
        "NSAudioCaptureUsageDescription": "需要访问系统音频来翻译正在播放的视频。"
      }
    }
  }
}